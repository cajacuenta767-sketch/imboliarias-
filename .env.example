# Base de datos (SQLite por defecto; para PostgreSQL ver README)
DATABASE_URL="file:./dev.db"

# Auth.js — genera uno con: openssl rand -base64 32
AUTH_SECRET="cambia-este-secreto"
AUTH_TRUST_HOST=true

# Sitio
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Habitta"

# Pagos: SANDBOX aprueba al instante, MANUAL deja la factura pendiente
PAYMENT_GATEWAY=SANDBOX

# Muestra los accesos de demostración en /ingresar (solo entornos de prueba)
NEXT_PUBLIC_DEMO_LOGIN=1

# Correo (opcional; sin SMTP_HOST los correos se imprimen en consola)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="Habitta <no-reply@habitta.test>"
